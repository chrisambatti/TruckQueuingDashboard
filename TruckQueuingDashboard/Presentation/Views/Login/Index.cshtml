@{
    Layout = null;
    ViewBag.Title = "Sign In";
}

<!doctype html>
<html lang="en"> 
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Truck Queuing Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css" rel="stylesheet">
    <style>
            body {
                background: #f0f2f5;
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 100vh;
                margin: 0;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .auth-wrapper {
                width: 100%;
                max-width: 420px;
                padding: 1.5rem;
            }

            .auth-card {
                background: #ffffff;
                border-radius: 1rem;
                box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
                padding: 2rem 2rem 1.5rem;
            }

            .auth-logo {
                text-align: center;
                margin-bottom: 1.3rem;
            }

                .auth-logo h2 {
                    font-weight: 700;
                    color: #1e293b;
                    margin: 0;
                    font-size: 1.6rem;
                }

                    .auth-logo h2 i {
                        color: #41598c;
                    }

                .auth-logo p {
                    color: #94a3b8;
                    font-size: 0.85rem;
                    margin: 0.25rem 0 0;
                }

            .form-label {
                font-weight: 600;
                font-size: 0.85rem;
                color: #1e293b;
                margin-bottom: 0.25rem;
            }

            .mandatory {
                color: #dc2626;
                font-weight: 700;
            }

            .form-control {
                border: 1px solid #d1d9e6;
                border-radius: 0.5rem;
                padding: 0.6rem 0.9rem;
                font-size: 0.9rem;
                transition: border-color 0.15s ease, box-shadow 0.15s ease;
            }

                .form-control:focus {
                    border-color: #41598c;
                    box-shadow: 0 0 0 3px rgba(51, 122, 183, 0.12);
                }

            .password-wrapper {
                position: relative;
            }

                .password-wrapper .form-control {
                    padding-right: 2.8rem;
                }

            .password-toggle {
                position: absolute;
                right: 0.8rem;
                top: 50%;
                transform: translateY(-50%);
                background: none;
                border: none;
                color: #94a3b8;
                cursor: pointer;
                padding: 0.2rem 0.4rem;
                font-size: 1.1rem;
                transition: color 0.2s ease;
            }

                .password-toggle:hover {
                    color: #41598c;
                }

            .forgot-link {
                font-size: 0.75rem;
                color: #94a3b8;
                text-decoration: none;
                transition: color 0.2s ease;
                cursor: pointer;
            }

                .forgot-link:hover {
                    color: #41598c;
                    text-decoration: underline;
                }

            .btn-submit {
                width: 100%;
                padding: 0.65rem;
                font-weight: 600;
                font-size: 0.9rem;
                letter-spacing: 0.04em;
                background: #41598c;
                border: none;
                border-radius: 0.5rem;
                color: #fff;
                transition: background 0.15s ease, box-shadow 0.15s ease;
                cursor: pointer;
            }

                .btn-submit:hover {
                    background: #286090;
                    box-shadow: 0 4px 12px rgba(51, 122, 183, 0.25);
                }

                .btn-submit:disabled {
                    opacity: 0.6;
                    cursor: not-allowed;
                }

            .auth-footer {
                text-align: center;
                margin-top: 1.5rem;
                font-size: 0.75rem;
                color: #94a3b8;
            }

                .auth-footer a {
                    color: #41598c;
                    text-decoration: none;
                }

                    .auth-footer a:hover {
                        text-decoration: underline;
                    }

            .alert-danger {
                border-radius: 0.5rem;
                font-size: 0.85rem;
                padding: 0.6rem 1rem;
                margin-bottom: 1rem;
            }

            .loader-overlay {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(255, 255, 255, 0.7);
                display: none;
                align-items: center;
                justify-content: center;
                z-index: 9999;
            }

                .loader-overlay.show {
                    display: flex;
                }

            .spinner {
                width: 40px;
                height: 40px;
                border: 4px solid #e2e8f0;
                border-top-color: #41598c;
                border-radius: 50%;
                animation: spin 0.6s linear infinite;
            }

            @@keyframes spin {
                to {
                    transform: rotate(360deg);
                }
            }

            /* ── Responsive ── */
            @@media (max-width: 480px) {
                .auth-card {
                    padding: 1.5rem 1.25rem;
                }

                .auth-logo h2 {
                    font-size: 1.3rem;
                }
            }
    </style>
</head>
<body>

    <!-- Loader -->
    <div id="loaderOverlay" class="loader-overlay">
        <div class="spinner"></div>
    </div>

    <div class="auth-wrapper">
        <div class="auth-card">

            <!-- Logo / Brand -->
            <div class="auth-logo">
                <img src="/images/WAC_logo.png" alt="WAC Logo" style="max-width:100px; height:auto; display:block; margin:0 auto 0.5rem;" />
                <h2 style="color:#64432e; font-size:34px; font-weight:700">Wade Adams</h2>
            </div>

            <!-- Login Form -->
            <form method="post" id="loginForm" asp-action="Index" asp-controller="Login">

                <!-- Username -->
                <div class="mb-3">
                    <label for="username" class="form-label">
                        Username <span class="mandatory">*</span>
                    </label>
                    <input type="text"
                           class="form-control"
                           id="username"
                           name="username"
                           placeholder="Enter your username"
                           required
                           autofocus />
                    <div class="invalid-feedback">Please enter your username.</div>
                </div>

                <!-- Password -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <label for="password" class="form-label">
                            Password <span class="mandatory">*</span>
                        </label>
                        <a href="#" class="forgot-link" onclick="handleForgotPassword(event)">Forgot Password?</a>
                    </div>
                    <div class="password-wrapper">
                        <input type="password"
                               class="form-control"
                               id="password"
                               name="password"
                               placeholder="Enter your password"
                               required />
                        <button type="button"
                                class="password-toggle"
                                id="passwordToggle"
                                aria-label="Toggle password visibility">
                            <i class="ri-eye-line"></i>
                        </button>
                    </div>
                    <div class="invalid-feedback">Please enter your password.</div>
                </div>

                <!-- Validation Summary -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                    </div>
                }

                <!-- Submit Button -->
                <button type="submit" class="btn-submit" id="loginBtn">
                    SIGN IN
                </button>

            </form>

            @* <!-- Footer -->
            <div class="auth-footer">
                &copy; @DateTime.Now.Year <a href="#">Truck Queuing Dashboard</a> — All rights reserved.
                <br />
                Contact your administrator for credentials.
            </div> *@

        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            // ── Password Toggle ──────────────────────────────────────
            document.getElementById('passwordToggle').addEventListener('click', function () {
                const input = document.getElementById('password');
                const icon = this.querySelector('i');
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.className = 'ri-eye-off-line';
                } else {
                    input.type = 'password';
                    icon.className = 'ri-eye-line';
                }
            });

            // ── Enter key submits form ──────────────────────────────
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    const form = document.getElementById('loginForm');
                    if (form) {
                        form.submit();
                    }
                }
            });

            // ── Forgot Password (demo) ──────────────────────────────
            function handleForgotPassword(e) {
                e.preventDefault();
                alert('Please contact your system administrator to reset your password.');
            }

            // ── Show loader on form submit ───────────────────────────
            document.getElementById('loginForm').addEventListener('submit', function () {
                document.getElementById('loaderOverlay').classList.add('show');
                document.getElementById('loginBtn').disabled = true;
            });

            // ── Remove loader on page load (if back/forward) ────────
            window.addEventListener('pageshow', function () {
                document.getElementById('loaderOverlay').classList.remove('show');
                document.getElementById('loginBtn').disabled = false;
            });
    </script>

</body>
</html>
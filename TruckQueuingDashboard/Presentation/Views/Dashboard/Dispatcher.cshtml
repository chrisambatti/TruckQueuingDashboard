@model TruckQueuingDashboard.Application.DTOs.DashboardViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Truck Queuing Dashboard";
     
        string FormatWaitingTime(TimeSpan time)
    {
        if (time.TotalSeconds < 60)
            return "Just now";
        else if (time.TotalMinutes < 60)
            return $"{(int)time.TotalMinutes}m";
        else if (time.TotalHours < 24)
            return $"{(int)time.TotalHours}h {(int)time.Minutes}m";
        else
            return $"{(int)time.TotalDays}d {(int)time.Hours}h";
    }
}
     
@section Styles {
    <!-- Page-specific CSS -->
    <link rel="stylesheet" href="~/css/dispatcher.css" asp-append-version="true" />

    <!-- Remix Icons -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css" rel="stylesheet">

    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.dataTables.min.css">

    <!-- Flatpickr CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
}             
       
<div class="container-fluid py-3">
    <div class="row"> 
        <div class="col-12">
             
            <div class="clinic-queue">
                <!-- Left Column: Bays & Up Next -->
                <div class="queue-stats">
                        
                    @{   
                        int bayCount = Model.MaxBays > 0 ? Model.MaxBays : 2;
                        var queue = Model.FleetEvents ?? new List<FleetEventDto>();
                        var bayTrucks = queue.Take(bayCount).ToList();
                        var upNext = queue.Skip(bayCount).Take(4).ToList();
                    }
                     
                    <!-- ─── Now Serving Card ─── -->
                    <div class="now-serving-card">
                        <div class="now-serving-header">
                             Now Serving                            
                        </div>
                         
                        @for (int i = 0; i < bayCount; i++)
                        {
                            var bay = bayTrucks.ElementAtOrDefault(i);
                            <div class="now-serving-ticket primary @(bay?.CalledNow == true ? "called-now" : "")">
                                <span class="serving-label">
                                    @if (bay?.CalledNow == true)
                                    {
                                        <i class="ri-star-fill me-1"></i>
                                    }
                                    Bay @(i + 1)
                                    @if (bay?.CalledNow == true)
                                    {
                                        <span class="called-badge">★ #@bay.CalledNowOrder</span>
                                    }
                                </span>
                                <span class="serving-number">
                                    @if (bay != null)
                                    {
                                        <text>@bay.FleetNumber</text>
                                        <small class="serving-turn">Turn @bay.Turn</small>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </span>
                            </div>
                        }
                    </div>

                    <!-- Up Next -->
                    <div class="now-serving-ticket secondary">
                        <span class="serving-label">Up Next</span>
                        <div class="up-next-list">
                            @if (upNext != null && upNext.Any())
                            {
                                foreach (var ev in upNext)
                                {
                                    var timeWaiting = DateTime.Now - ev.EventTimestamp;
                                    string waitingText = FormatWaitingTime(timeWaiting);

                                    <div class="up-next-item" data-timestamp="@ev.EventTimestamp.ToString("yyyy-MM-dd HH:mm:ss")">
                                        <span class="up-next-turn">#@ev.Turn</span>
                                        <span class="up-next-truck">@ev.FleetNumber</span>
                                        <span class="up-next-status @(ev.Event == "Entry" ? "status-waiting" : "status-exit")">
                                            @(ev.Event == "Entry" ? "Waiting" : "Exit")
                                        </span>
                                        @if (ev.Event == "Entry")
                                        {
                                            <span class="up-next-waiting"><i class="ri-time-line"></i> @waitingText</span>
                                        }
                                    </div>
                                }
                            }
                            else 
                            {
                                <div class="up-next-item empty">— No more trucks —</div>
                            }
                        </div>
                    </div>   
                       
                          
                    <!-- Recent Exits -->
                    <div class="recent-exits-card">
                        <div class="recent-exits-header">
                             Recent Exits
                        </div>
                        <div class="recent-exits-list">
                            @if (Model.RecentExits != null && Model.RecentExits.Any())
                            {
                                foreach (var exit in Model.RecentExits)
                                {
                                    <div class="recent-exit-item">
                                        <span class="recent-exit-truck">@exit.FleetNumber</span>
                                        <span class="recent-exit-time">@exit.EventTimestamp.ToString("HH:mm")</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="recent-exit-item empty">— No recent exits —</div>
                            }
                        </div>
                    </div>




                </div>
                <!-- Right Column: Waiting List -->
                <div class="waiting-list">
                    <div class="waiting-header">
                        <div class="d-flex align-items-center justify-content-between w-100 flex-wrap">
                            <div class="d-flex align-items-center gap-2">
                                <span class="waiting-title">Waiting</span>
                                <span class="waiting-count" id="waitingCount">@(Model.FleetEvents?.Count() ?? 0)</span>
                            </div>
                            <button class="btn rounded-3 btn-sm" id="viewHistoryBtn">
                                View History
                            </button>
                        </div>
                    </div>
                    <div class="waiting-table-wrapper">
                        <table id="fleetTable" class="table waiting-table table-striped">
                            <thead>
                                <tr>
                                    <th class="turn-col">Turn</th>
                                    <th>Truck</th>
                                    <th>Status</th>
                                    <th>Timestamp</th>
                                    <th class="action-col">Action</th>
                                    <th style="display:none;">SortOrder</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
  
<!-- History Modal -->
<div class="modal fade" id="historyModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-scroll="false">
    <div class="modal-dialog modal-dialog-scrollable modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ri-history-line me-2"></i>Event History</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="history-modal-toolbar">
                    <div>
                        <span class="history-total-label">Total Events:</span>
                        <span class="history-total-count" id="historyTotalCount">0</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <!-- Search Input -->
                        <div class="history-filter-group">
                            <label for="historySearch" class="history-filter-label">Search:</label>
                            <input type="text" id="historySearch" class="history-search-input" placeholder="Search trucks, events..." />
                        </div> 
                        <div class="history-filter-group">
                            <label for="historyFromDate" class="history-filter-label">From:</label>
                            <input type="text" id="historyFromDate" class="history-date-input" placeholder="Select date">
                        </div>
                        <div class="history-filter-group">
                            <label for="historyToDate" class="history-filter-label">To:</label>
                            <input type="text" id="historyToDate" class="history-date-input" placeholder="Select date">
                        </div>
                        <div class="history-filter-group">
                            <select id="historyFilter" class="history-filter-select">
                                <option value="View All" selected>View All</option>
                                <option value="Entry">Entry</option>
                                <option value="Exit">Exit</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="history-table-wrapper">
                    <table id="historyTable" class="history-table">
                        <thead>
                            <tr>
                                <th>Sr No.</th>
                                <th>Truck</th>
                                <th>Event</th>
                                <th>Location</th>
                                <th>Timestamp</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn history-btn-close" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="ri-question-line me-2"></i>Confirm Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="confirmModalBody">Are you sure?</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmModalOk">Confirm</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>

    <!-- Flatpickr JS -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <!-- Dashboard JS -->
    <script src="~/js/dispatcher.js" asp-append-version="true"></script>
} 